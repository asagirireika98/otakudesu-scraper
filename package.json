{
  "name": "otakudesu-scraper",
  "version": "1.0.0",
  "description": "Scrape anime episodes from otakudesu and generate M3U playlists for VLC",
  "type": "module",
  "scripts": {
    "scrape": "tsx src/index.ts",
    "start": "tsx src/bot.ts",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "bot": "tsx src/bot.ts",
    "deploy-commands": "tsx src/bot/deploy.ts",
    "search": "tsx src/manage-anime.ts search",
    "ongoing": "tsx src/manage-anime.ts ongoing",
    "add-anime": "tsx src/manage-anime.ts add",
    "remove-anime": "tsx src/manage-anime.ts remove",
    "list-anime": "tsx src/manage-anime.ts list"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "octokit": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
