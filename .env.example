# Required for Gist updates
GIST_ID=
GH_PAT=

# Discord webhook for scraper notifications (used by GitHub Actions cron)
DISCORD_WEBHOOK_URL=

# Discord bot (for slash commands)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channel IDs for bot
DISCORD_NOTIFY_CHANNEL_ID=
DISCORD_MAIN_CHANNEL_ID=

# Worker base URL for M3U playlist generation
WORKER_BASE_URL=

# M3U mode: "worker" (needs deployed Worker) or "direct" (otakudesu URLs)
M3U_MODE=worker
